# ==============================================================================
# AMAN Agrovet V3 — Environment Variables Template
# Copy this file to .env (or backend/.env & frontend/.env) for local development.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Backend Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database: Google Cloud SQL (PostgreSQL) (Used in Phase 2+) ---
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=change_me
SQL_DB_NAME=aman_agrovet_v3
# Optional connection string for local Drizzle / PostgreSQL tooling
DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/aman_agrovet_v3

# --- Firebase Admin SDK (Server-Side Token Verification, Used in Phase 3+) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
