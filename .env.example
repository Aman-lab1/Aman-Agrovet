# ==============================================================================
# AMAN Agrovet V3 — Environment Variables Template
# Copy this file to .env (or backend/.env & frontend/.env) for local development.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Backend Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database: Google Cloud SQL / Local PostgreSQL ---
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=change_me
SQL_DB_NAME=aman_agrovet_v3
DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/aman_agrovet_v3

# --- Built-in Username + Passcode Authentication (JWT) ---
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- Initial Business Owner Bootstrap Seed ---
INITIAL_OWNER_USERNAME=aman
INITIAL_OWNER_NAME=Aman Rajpura
INITIAL_OWNER_PASSCODE=change_me_1234

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api
